<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Primary Base Orbital Ring -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M 54,31 A 23,23 0 1,0 54.01,31 Z" />

    <!-- Rotated Secondary Orbital Ring -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-38">

        <!-- Outer Elliptical Orbit -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:pathData="M 54,38 A 27,16 0 1,0 54.01,38 Z" />

        <!-- Satellite Node on Secondary Orbit -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 81,54 A 4,4 0 1,0 81.01,54 Z" />
    </group>

    <!-- Central Core Sphere -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 54,48 A 6.5,6.5 0 1,0 54.01,48 Z" />
</vector>
