<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Primary Host System Sphere Ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:pathData="M 54,28.5 A 25.5,25.5 0 1,0 54.01,28.5 Z" />

    <!-- Tilted Guest Environment Orbital Ring (-45 degrees) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeAlpha="0.75"
            android:pathData="M 54,42.2 A 27.2,11.8 0 1,0 54.01,42.2 Z" />
    </group>

    <!-- Central System Core Dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,48.8 A 5.2,5.2 0 1,0 54.01,48.8 Z" />
</vector>
